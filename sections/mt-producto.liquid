{{ 'mt-styles.css' | asset_url | stylesheet_tag }}
{{ 'mt-scripts.js' | asset_url | script_tag }}

{% style %}
  #shopify-section-{{ section.id }} {
    padding-top: {{ section.settings.padding_top }}px;
    padding-bottom: {{ section.settings.padding_bottom }}px;
    background: {{ section.settings.bg_color }};
  }
{% endstyle %}

{% assign current_variant = product.selected_or_first_available_variant %}

<section class="mt-section mt-producto" data-mt-producto>
  <div class="mt-container">
    <div class="mt-producto-grid">

      <!-- Galería -->
      <div class="mt-producto-galeria">
        <div class="mt-producto-principal" data-mt-galeria{% if product.media.size > 1 %} data-mt-galeria-auto="4500"{% endif %}>
          {% for media in product.media %}
            <img class="mt-producto-imagen{% if forloop.first %} mt-activa{% endif %}"
                 data-mt-galeria-imagen="{{ forloop.index0 }}"
                 data-mt-media-id="{{ media.id }}"
                 src="{{ media | image_url: width: 1200 }}"
                 alt="{{ media.alt | escape }}"
                 {% if forloop.first %}loading="eager" fetchpriority="high"{% else %}loading="lazy"{% endif %}>
          {% else %}
            <img src="{{ 'mt-hero-fondo.jpg' | asset_url }}" alt="{{ product.title }}" loading="eager">
          {% endfor %}
        </div>
        {% if product.media.size > 1 %}
          <div class="mt-producto-miniaturas">
            {% for media in product.media %}
              <button class="mt-miniatura{% if forloop.first %} mt-activa{% endif %}" data-mt-miniatura="{{ forloop.index0 }}" data-mt-media-id="{{ media.id }}" aria-label="{{ 'Imagen' | append: ' ' | append: forloop.index }}">
                <img src="{{ media | image_url: width: 200 }}" alt="{{ media.alt | escape }}" loading="lazy">
              </button>
            {% endfor %}
          </div>
        {% endif %}
      </div>

      <!-- Columna de compra -->
      <div class="mt-producto-compra">
        {% if section.settings.eyebrow != blank %}
          <p class="mt-eyebrow">{{ section.settings.eyebrow }}</p>
        {% endif %}
        <h1 class="mt-h2">{{ product.title }}</h1>

        <div class="mt-producto-precio" data-mt-precio>
          {% if current_variant.compare_at_price > current_variant.price %}
            <s class="mt-precio-antes" data-mt-precio-antes>{{ current_variant.compare_at_price | money }}</s>
          {% endif %}
          <span class="mt-precio-actual" data-mt-precio-actual>{{ current_variant.price | money }}</span>
        </div>

        {% if section.settings.intro != blank %}
          <p class="mt-body mt-producto-intro">{{ section.settings.intro | newline_to_br }}</p>
        {% endif %}

        {% comment %} Avisos de ofertas automáticas activas (2x1 / 3x2) {% endcomment %}
        {% case product.handle %}
          when 'creative-cocktail-glass-porcupine-fish-swan-rose-octopus-bird-design-cocktail-glass-novelty-drink-cup-for-ktv-bar-night-party' %}
            <div class="mt-oferta-aviso mt-oferta-2x1">
              <span class="mt-oferta-tag">2X1</span>
              <span class="mt-oferta-texto">Elige 2 diseños (o el mismo) y paga solo 1. Se aplica automáticamente en el carrito.</span>
            </div>
          when 'zinc-alloy-bottle-opener-wall-mounted-vintage-glass-bar-beer-cap-cover-opener-bar-drinking-accessories-kitchen-tool-apriscatole', 'led-white-birch-branch-festive-lights-christmas-tree-branch-fairy-garland-light-party-wedding-decoration-twig-dinner-table-lamp' %}
            <div class="mt-oferta-aviso mt-oferta-3x2">
              <span class="mt-oferta-tag">3X2</span>
              <span class="mt-oferta-texto">Compra 2 unidades y llévate la 3ª gratis. Se aplica automáticamente en el carrito.</span>
            </div>
        {% endcase %}

        {% comment %} Aviso de producto complementario con descuento {% endcomment %}
        {% assign mt_combo_handle = '' %}
        {% assign mt_combo_pct = 15 %}
        {% case product.handle %}
          when '120w-cordless-handheld-vacuum-cleaner-small-mini-portable-car' %}
            {% assign mt_combo_handle = 'removes-lint-from-clothes-electric-pet-hair-remover-clothing-home-cats-hair-brush-take-out-of-clothes-hairs-cleaning-roller' %}
          when 'removes-lint-from-clothes-electric-pet-hair-remover-clothing-home-cats-hair-brush-take-out-of-clothes-hairs-cleaning-roller' %}
            {% assign mt_combo_handle = '120w-cordless-handheld-vacuum-cleaner-small-mini-portable-car' %}
          when 'kinscoter-aroma-diffuser-air-humidifier-ultrasonic-cool-mist-maker-fogger-led-essential-oil-flame-lamp-difusor' %}
            {% assign mt_combo_handle = 'free-20cones-creative-home-decor-backflow-stick-incense-burner-ceramic-censer-home-decoration-use-in-home-teahouse' %}
          when 'free-20cones-creative-home-decor-backflow-stick-incense-burner-ceramic-censer-home-decoration-use-in-home-teahouse' %}
            {% assign mt_combo_handle = 'kinscoter-aroma-diffuser-air-humidifier-ultrasonic-cool-mist-maker-fogger-led-essential-oil-flame-lamp-difusor' %}
          when 'diatomite-bathroom-carpet-foot-mat-quick-dry-bath-mats-non-slip-shower-rug-toilet-pad-doormat-washable' %}
            {% assign mt_combo_handle = 'bathroom-shelf-aluminum-alloy-shampoo-rack-makeup-storage-organizer-shower-shelf-bathroom-accessories-no-drill-wall-corner-shelf' %}
          when 'bathroom-shelf-aluminum-alloy-shampoo-rack-makeup-storage-organizer-shower-shelf-bathroom-accessories-no-drill-wall-corner-shelf' %}
            {% assign mt_combo_handle = 'diatomite-bathroom-carpet-foot-mat-quick-dry-bath-mats-non-slip-shower-rug-toilet-pad-doormat-washable' %}
        {% endcase %}
        {% if mt_combo_handle != '' %}
          {% assign mt_combo_producto = all_products[mt_combo_handle] %}
          {% if mt_combo_producto %}
            <a href="{{ mt_combo_producto.url }}" class="mt-combo-aviso">
              <img src="{{ mt_combo_producto.featured_image | image_url: width: 120 }}" alt="{{ mt_combo_producto.title | escape }}" loading="lazy">
              <span class="mt-combo-texto">
                <strong>-{{ mt_combo_pct }}%</strong> en {{ mt_combo_producto.title }} al comprarlo junto con este producto
              </span>
            </a>
          {% endif %}
        {% endif %}

        {% form 'product', product, data-mt-producto-form: true %}
          <input type="hidden" name="id" value="{{ current_variant.id }}" data-mt-variant-id>

          {% unless product.has_only_default_variant %}
            <div class="mt-producto-opciones">
              {% for option in product.options_with_values %}
                {% unless option.values.size == 1 %}
                  <div class="mt-opcion">
                    <p class="mt-opcion-label">{{ option.name }}</p>
                    <div class="mt-opcion-valores" data-mt-opcion-index="{{ forloop.index0 }}">
                      {% for value in option.values %}
                        <button type="button"
                                class="mt-opcion-valor{% if value == option.selected_value %} mt-activa{% endif %}"
                                data-mt-opcion-valor="{{ value | escape }}">{{ value }}</button>
                      {% endfor %}
                    </div>
                  </div>
                {% endunless %}
              {% endfor %}
            </div>
          {% endunless %}

          <button type="submit" name="add" class="mt-btn mt-btn-primary mt-producto-boton" data-mt-boton-add
                  data-mt-texto-disponible="{{ section.settings.boton_texto | escape }}"
                  data-mt-texto-agotado="{{ section.settings.texto_agotado | escape }}"
                  {% if current_variant.available == false %}disabled{% endif %}>
            <span data-mt-boton-texto>
              {% if current_variant.available == false %}
                {{ section.settings.texto_agotado }}
              {% else %}
                {{ section.settings.boton_texto }}
              {% endif %}
            </span>
          </button>
        {% endform %}

        <script type="application/json" data-mt-variantes>
          [
            {% for variant in product.variants %}
              {
                "id": {{ variant.id | json }},
                "price": {{ variant.price | json }},
                "compare_at_price": {{ variant.compare_at_price | json }},
                "available": {{ variant.available | json }},
                "option1": {{ variant.option1 | json }},
                "option2": {{ variant.option2 | json }},
                "option3": {{ variant.option3 | json }},
                "featured_image_id": {{ variant.featured_image.id | json }}
              }{% unless forloop.last %},{% endunless %}
            {% endfor %}
          ]
        </script>

        <!-- Confianza -->
        <div class="mt-producto-confianza">
          {% for block in section.blocks %}
            {% if block.type == 'confianza' %}
              <div class="mt-confianza-item" {{ block.shopify_attributes }}>
                <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6"><path d="M9 12l2 2 4-4"/><circle cx="12" cy="12" r="9"/></svg>
                <span>{{ block.settings.texto }}</span>
              </div>
            {% endif %}
          {% endfor %}
        </div>
      </div>
    </div>

    <!-- Descripción rica -->
    <div class="mt-producto-detalle">
      {% if section.settings.detalle_titulo != blank %}
        <h2 class="mt-h2 mt-reveal mt-center">{{ section.settings.detalle_titulo }}</h2>
      {% endif %}

      {% assign feature_blocks = section.blocks | where: 'type', 'caracteristica' %}
      {% if feature_blocks.size > 0 %}
        <div class="mt-grid mt-grid-3 mt-producto-caracteristicas">
          {% for block in feature_blocks %}
            <div class="mt-caracteristica mt-reveal mt-reveal-{{ forloop.index }}" {{ block.shopify_attributes }}>
              <h3 class="mt-h3">{{ block.settings.titulo }}</h3>
              <p class="mt-body">{{ block.settings.texto }}</p>
            </div>
          {% endfor %}
        </div>
      {% endif %}

      {% if section.settings.incluye != blank %}
        {% assign incluye_lineas = section.settings.incluye | newline_to_br | split: '<br />' %}
        <div class="mt-producto-incluye mt-reveal">
          <h3 class="mt-h3">{{ section.settings.incluye_titulo }}</h3>
          <ul>
            {% for linea in incluye_lineas %}
              {% if linea != blank %}<li>{{ linea | strip }}</li>{% endif %}
            {% endfor %}
          </ul>
        </div>
      {% endif %}

      {% if product.description != blank %}
        <div class="mt-body mt-producto-descripcion mt-reveal">{{ product.description }}</div>
      {% endif %}
    </div>
  </div>
</section>

<style>
  #shopify-section-{{ section.id }} .mt-producto-grid {
    display: grid;
    grid-template-columns: 1.1fr 1fr;
    gap: 56px;
    align-items: start;
  }
  #shopify-section-{{ section.id }} .mt-producto-principal {
    position: relative;
    aspect-ratio: 1/1;
    border-radius: var(--mt-radius-lg);
    overflow: hidden;
    background: var(--mt-bg);
  }
  #shopify-section-{{ section.id }} .mt-producto-imagen {
    position: absolute; inset: 0;
    width: 100%; height: 100%; object-fit: cover;
    opacity: 0; transition: opacity 0.6s ease, transform 0.5s var(--mt-ease);
    transform: scale(1.08);
    cursor: zoom-in;
  }
  #shopify-section-{{ section.id }} .mt-producto-imagen.mt-activa {
    opacity: 1;
    position: relative;
    animation: mt-kenburns 5s ease-in-out infinite alternate;
  }
  #shopify-section-{{ section.id }} .mt-producto-principal:hover .mt-producto-imagen.mt-activa {
    animation-play-state: paused;
    transform: scale(1.3) !important;
  }
  @keyframes mt-kenburns {
    from { transform: scale(1.08); }
    to { transform: scale(1.24); }
  }
  @media (prefers-reduced-motion: reduce) {
    #shopify-section-{{ section.id }} .mt-producto-imagen.mt-activa { animation: none; }
  }
  #shopify-section-{{ section.id }} .mt-producto-miniaturas { display: flex; gap: 10px; margin-top: 14px; flex-wrap: wrap; }
  #shopify-section-{{ section.id }} .mt-miniatura {
    width: 72px; height: 72px; border-radius: 12px; overflow: hidden;
    border: 2px solid transparent; padding: 0; cursor: pointer; background: var(--mt-bg);
    transition: border-color 0.25s ease, transform 0.1s var(--mt-ease);
  }
  #shopify-section-{{ section.id }} .mt-miniatura.mt-activa { border-color: var(--mt-accent); }
  #shopify-section-{{ section.id }} .mt-miniatura:active { transform: scale(0.93); }
  #shopify-section-{{ section.id }} .mt-miniatura img { width: 100%; height: 100%; object-fit: cover; }

  #shopify-section-{{ section.id }} .mt-producto-precio { display: flex; align-items: baseline; gap: 12px; margin: 18px 0 4px; }
  #shopify-section-{{ section.id }} .mt-precio-actual { font-family: var(--font-heading-family); font-weight: 700; font-size: 26px; }
  #shopify-section-{{ section.id }} .mt-precio-antes { color: var(--mt-muted); font-size: 18px; }
  #shopify-section-{{ section.id }} .mt-producto-intro { margin-top: 12px; }

  #shopify-section-{{ section.id }} .mt-oferta-aviso {
    display: flex; align-items: center; gap: 12px;
    margin-top: 18px; padding: 14px 18px;
    border-radius: var(--mt-radius-sm);
    background: rgba(47,95,255,0.08);
    border: 1.5px solid rgba(47,95,255,0.25);
  }
  #shopify-section-{{ section.id }} .mt-oferta-aviso .mt-oferta-tag {
    flex-shrink: 0;
    font-family: var(--font-heading-family);
    font-weight: 700; font-size: 20px; letter-spacing: 0.02em;
    color: var(--mt-accent);
    background: #fff; border-radius: 999px; padding: 4px 14px;
  }
  #shopify-section-{{ section.id }} .mt-oferta-aviso .mt-oferta-texto { font-size: 14px; color: var(--mt-text); font-weight: 600; }
  #shopify-section-{{ section.id }} .mt-oferta-3x2 { background: rgba(198,255,61,0.14); border-color: rgba(20,22,26,0.15); }
  #shopify-section-{{ section.id }} .mt-oferta-3x2 .mt-oferta-tag { color: var(--mt-text); }

  #shopify-section-{{ section.id }} .mt-combo-aviso {
    display: flex; align-items: center; gap: 14px;
    margin-top: 14px; padding: 12px 16px;
    border-radius: var(--mt-radius-sm);
    background: var(--mt-surface);
    border: 1.5px dashed var(--mt-border);
    text-decoration: none;
    transition: border-color 0.2s ease, transform 0.1s var(--mt-ease);
  }
  #shopify-section-{{ section.id }} .mt-combo-aviso:hover { border-color: var(--mt-accent); }
  #shopify-section-{{ section.id }} .mt-combo-aviso:active { transform: scale(0.98); }
  #shopify-section-{{ section.id }} .mt-combo-aviso img { width: 52px; height: 52px; object-fit: cover; border-radius: var(--mt-radius-sm); flex-shrink: 0; }
  #shopify-section-{{ section.id }} .mt-combo-aviso .mt-combo-texto { font-size: 13.5px; color: var(--mt-muted); line-height: 1.4; }
  #shopify-section-{{ section.id }} .mt-combo-aviso .mt-combo-texto strong { color: var(--mt-text); }

  #shopify-section-{{ section.id }} .mt-producto-opciones { margin: 26px 0; display: flex; flex-direction: column; gap: 16px; }
  #shopify-section-{{ section.id }} .mt-opcion-label { font-weight: 700; font-size: 14px; margin-bottom: 8px; }
  #shopify-section-{{ section.id }} .mt-opcion-valores { display: flex; gap: 8px; flex-wrap: wrap; }
  #shopify-section-{{ section.id }} .mt-opcion-valor {
    padding: 9px 18px; border-radius: 999px; border: 1.5px solid var(--mt-border);
    background: #fff; cursor: pointer; font-size: 14px;
    transition: border-color 0.2s ease, background 0.2s ease, color 0.2s ease, transform 0.1s var(--mt-ease);
  }
  #shopify-section-{{ section.id }} .mt-opcion-valor.mt-activa { border-color: var(--mt-accent); background: rgba(47,95,255,0.08); color: var(--mt-accent-dark); font-weight: 700; }
  #shopify-section-{{ section.id }} .mt-opcion-valor:active { transform: scale(0.95); }
  #shopify-section-{{ section.id }} .mt-opcion-valor[disabled] { opacity: 0.35; text-decoration: line-through; cursor: not-allowed; }

  #shopify-section-{{ section.id }} .mt-producto-boton { width: 100%; margin-top: 12px; padding: 18px; font-size: 16px; }
  #shopify-section-{{ section.id }} .mt-producto-boton[disabled] { opacity: 0.5; cursor: not-allowed; box-shadow: none; }

  #shopify-section-{{ section.id }} .mt-producto-confianza { margin-top: 32px; display: flex; flex-direction: column; gap: 10px; }
  #shopify-section-{{ section.id }} .mt-confianza-item { display: flex; align-items: center; gap: 10px; font-size: 14px; color: var(--mt-muted); }
  #shopify-section-{{ section.id }} .mt-confianza-item svg { width: 18px; height: 18px; color: var(--mt-accent); flex-shrink: 0; }

  #shopify-section-{{ section.id }} .mt-producto-detalle { margin-top: 96px; }
  #shopify-section-{{ section.id }} .mt-producto-caracteristicas { margin-top: 40px; }
  #shopify-section-{{ section.id }} .mt-caracteristica {
    background: var(--mt-surface); border-radius: var(--mt-radius); padding: 26px; box-shadow: var(--mt-shadow);
  }
  #shopify-section-{{ section.id }} .mt-producto-incluye {
    margin-top: 48px; background: var(--mt-surface); border-radius: var(--mt-radius); padding: 32px; box-shadow: var(--mt-shadow);
    max-width: 480px;
  }
  #shopify-section-{{ section.id }} .mt-producto-incluye ul { margin: 12px 0 0; padding-left: 20px; color: var(--mt-muted); }
  #shopify-section-{{ section.id }} .mt-producto-incluye li { margin-bottom: 6px; }
  #shopify-section-{{ section.id }} .mt-producto-descripcion { margin-top: 48px; max-width: 720px; }
  #shopify-section-{{ section.id }} .mt-producto-descripcion :is(h2,h3) { font-family: var(--font-heading-family); color: var(--mt-text); margin: 24px 0 8px; }
  #shopify-section-{{ section.id }} .mt-producto-descripcion ul { padding-left: 20px; }

  @media (max-width: 989px) {
    #shopify-section-{{ section.id }} .mt-producto-grid { grid-template-columns: 1fr; gap: 32px; }
  }
</style>

{% schema %}
{
  "name": "MT – Página de producto",
  "tag": "section",
  "settings": [
    { "type": "color", "id": "bg_color", "label": "Color de fondo", "default": "#FFFFFF" },
    { "type": "text", "id": "eyebrow", "label": "Texto pequeño superior", "default": "Esenciales de hogar inteligente" },
    { "type": "textarea", "id": "intro", "label": "Frase corta bajo el precio" },
    { "type": "text", "id": "boton_texto", "label": "Texto del botón de compra", "default": "Añadir al carrito" },
    { "type": "text", "id": "texto_agotado", "label": "Texto si está agotado", "default": "Agotado" },
    { "type": "header", "content": "Detalle del producto" },
    { "type": "text", "id": "detalle_titulo", "label": "Título de la sección de detalle", "default": "Todo lo que necesitas saber" },
    { "type": "text", "id": "incluye_titulo", "label": "Título de 'qué incluye'", "default": "Qué incluye" },
    { "type": "textarea", "id": "incluye", "label": "Qué incluye (un elemento por línea)", "default": "1x producto\n1x cable de carga\n1x manual de instrucciones" },
    { "type": "header", "content": "Espaciado" },
    { "type": "range", "id": "padding_top", "label": "Espacio superior (px)", "min": 0, "max": 160, "step": 8, "default": 56 },
    { "type": "range", "id": "padding_bottom", "label": "Espacio inferior (px)", "min": 0, "max": 160, "step": 8, "default": 96 }
  ],
  "blocks": [
    {
      "type": "confianza",
      "name": "Fila de confianza",
      "settings": [
        { "type": "text", "id": "texto", "label": "Texto", "default": "Envío con seguimiento en todos los pedidos" }
      ]
    },
    {
      "type": "caracteristica",
      "name": "Característica",
      "settings": [
        { "type": "text", "id": "titulo", "label": "Título", "default": "Fácil de usar" },
        { "type": "textarea", "id": "texto", "label": "Texto", "default": "Listo para usar en menos de un minuto, sin instalación complicada." }
      ]
    }
  ],
  "presets": [
    {
      "name": "MT – Página de producto",
      "blocks": [
        { "type": "confianza", "settings": { "texto": "Envío con seguimiento en todos los pedidos" } },
        { "type": "confianza", "settings": { "texto": "Devolución gratuita en 30 días" } },
        { "type": "confianza", "settings": { "texto": "Pago 100% seguro" } },
        { "type": "caracteristica" },
        { "type": "caracteristica" },
        { "type": "caracteristica" }
      ]
    }
  ]
}
{% endschema %}
