{{ 'mt-styles.css' | asset_url | stylesheet_tag }}

{% style %}
  #shopify-section-{{ section.id }} {
    padding-top: {{ section.settings.padding_top }}px;
    padding-bottom: {{ section.settings.padding_bottom }}px;
    background: {{ section.settings.bg_color }};
  }
{% endstyle %}

<section class="mt-section mt-beneficios">
  <div class="mt-container">
    <div class="mt-grid mt-grid-4">
      {% for block in section.blocks %}
        <div class="mt-beneficio mt-reveal mt-reveal-{{ forloop.index }}" {{ block.shopify_attributes }}>
          <div class="mt-beneficio-icono">
            {% case block.settings.icono %}
              {% when 'envio' %}
                <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6"><path d="M3 7h11v9H3zM14 10h4l3 3v3h-7z"/><circle cx="7" cy="18" r="1.6"/><circle cx="17.5" cy="18" r="1.6"/></svg>
              {% when 'garantia' %}
                <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6"><path d="M12 3l7 3v6c0 4.5-3 7.5-7 9-4-1.5-7-4.5-7-9V6z"/><path d="M9 12l2 2 4-4"/></svg>
              {% when 'devolucion' %}
                <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6"><path d="M4 9a8 8 0 1 1 2 5.3"/><path d="M4 4v5h5"/></svg>
              {% when 'pago' %}
                <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6"><rect x="3" y="6" width="18" height="13" rx="2"/><path d="M3 10h18M7 14h4"/></svg>
              {% else %}
                <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6"><circle cx="12" cy="12" r="9"/></svg>
            {% endcase %}
          </div>
          <p class="mt-h3">{{ block.settings.titulo }}</p>
          <p class="mt-body">{{ block.settings.texto }}</p>
        </div>
      {% endfor %}
    </div>
  </div>
</section>

<style>
  #shopify-section-{{ section.id }} .mt-beneficio { text-align: {{ section.settings.alineacion }}; }
  #shopify-section-{{ section.id }} .mt-beneficio-icono {
    width: 52px; height: 52px;
    display: flex; align-items: center; justify-content: center;
    border-radius: 16px;
    background: rgba(47, 95, 255, 0.1);
    color: var(--mt-accent);
    margin-bottom: 16px;
    {% if section.settings.alineacion == 'center' %} margin-left: auto; margin-right: auto; {% endif %}
  }
  #shopify-section-{{ section.id }} .mt-beneficio-icono svg { width: 26px; height: 26px; }
  #shopify-section-{{ section.id }} .mt-beneficio .mt-h3 { margin-bottom: 4px; }
</style>

{% schema %}
{
  "name": "MT – Barra de confianza",
  "tag": "section",
  "settings": [
    { "type": "color", "id": "bg_color", "label": "Color de fondo", "default": "#FFFFFF" },
    { "type": "select", "id": "alineacion", "label": "Alineación", "options": [
        {"value": "left", "label": "Izquierda"},
        {"value": "center", "label": "Centro"}
      ], "default": "center" },
    { "type": "header", "content": "Espaciado" },
    { "type": "range", "id": "padding_top", "label": "Espacio superior (px)", "min": 0, "max": 160, "step": 8, "default": 48 },
    { "type": "range", "id": "padding_bottom", "label": "Espacio inferior (px)", "min": 0, "max": 160, "step": 8, "default": 48 }
  ],
  "blocks": [
    {
      "type": "beneficio",
      "name": "Beneficio",
      "settings": [
        { "type": "select", "id": "icono", "label": "Icono", "options": [
            {"value": "envio", "label": "Envío"},
            {"value": "garantia", "label": "Garantía"},
            {"value": "devolucion", "label": "Devolución"},
            {"value": "pago", "label": "Pago seguro"}
          ], "default": "envio" },
        { "type": "text", "id": "titulo", "label": "Título", "default": "Envío rápido" },
        { "type": "text", "id": "texto", "label": "Texto", "default": "Recíbelo en pocos días" }
      ]
    }
  ],
  "presets": [
    {
      "name": "MT – Barra de confianza",
      "blocks": [
        { "type": "beneficio", "settings": { "icono": "envio", "titulo": "Envío rápido", "texto": "A toda España en pocos días" } },
        { "type": "beneficio", "settings": { "icono": "garantia", "titulo": "Garantía 2 años", "texto": "Compra con confianza" } },
        { "type": "beneficio", "settings": { "icono": "devolucion", "titulo": "Devolución fácil", "texto": "30 días para cambiar de idea" } },
        { "type": "beneficio", "settings": { "icono": "pago", "titulo": "Pago 100% seguro", "texto": "Tus datos siempre protegidos" } }
      ]
    }
  ]
}
{% endschema %}
